# Remote embedding service. The OpenAPI doc describes /v1/embeddings.
EMBEDDING_BASE_URL=http://192.168.70.249:8000
EMBEDDING_ENDPOINT_PATH=/v1/embeddings
EMBEDDING_MODELS_PATH=/v1/models
EMBEDDING_MODEL=./models/Qwen3-VL-Embedding-2B
EMBEDDING_TIMEOUT=120
EMBEDDING_MODEL_PROBE_TIMEOUT=5
EMBEDDING_MAX_CONCURRENCY=8
# This model rejects an explicit dimensions parameter (no matryoshka
# support). Leave it unset and use the model's native width.
EMBEDDING_DIMENSIONS=none
EMBEDDING_ENCODING_FORMAT=float
EMBEDDING_SYSTEM_PROMPT=Represent the user's input.

# Agent1 drawing page classification.
# Correct matches on real drawings score 0.73-0.83; the best
# wrong category reaches ~0.72. Tuned on one 23-page PDF.
DRAWING_CLASSIFICATION_MIN_SCORE=0.675
AGENT1_RENDER_PROCESSES=4
AGENT1_EMBEDDING_CONCURRENCY=8
AGENT1_MAX_IN_FLIGHT=12

# Built-in MinerU parsing service.
MINERU_BASE_URL=http://192.168.70.249:8888
MINERU_TIMEOUT=300
# Fail fast when the service is unreachable instead of waiting for the full
# read timeout.
MINERU_CONNECT_TIMEOUT=10
MINERU_BACKEND=hybrid-engine
MINERU_EFFORT=medium
MINERU_LANG_LIST=en

# Agent2/Agent3 structured table recognition uses Claude or GLM vision.
# mineru_claude — MinerU layout locate + Claude vision
# yolo_claude — YOLO table locate; MinerU fallback when no box reaches the acceptance threshold + Claude vision
# yolo_glm — same YOLO locate path as yolo_claude, with OpenRouter GLM vision
BLOCK_DIAGRAM_TABLE_STRATEGY=yolo_claude
BLOCK_DIAGRAM_TABLE_BEDROCK_MAX_TRANSPORT_BYTES=5242880
# OpenRouter model for yolo_glm (falls back to OPENROUTER_MODEL when unset).
# BLOCK_DIAGRAM_TABLE_OPENROUTER_MODEL=z-ai/glm-5.3-flash

# Agent2 overall-layout table vision extraction.
# yolo_glm     — YOLO table locate + MinerU fallback, GLM vision via OpenRouter (default)
# mineru_glm   — MinerU layout locate + GLM vision
# yolo_claude  — YOLO table locate + MinerU fallback, Claude vision via Bedrock
# mineru_claude— MinerU layout locate + Claude vision
AGENT2_OVERALL_TABLE_STRATEGY=yolo_glm
AGENT2_MINERU_MAX_ATTEMPTS=3
AGENT2_MINERU_RETRY_MAX_DIMENSION=6000
# Output cap for the selected vision provider (Bedrock or OpenRouter).
# GLM-5.3-Flash spends part of this budget on reasoning tokens before emitting
# JSON, so a small cap yields truncated or empty content. Keep generous
# headroom: 12000 is a safe starting point for the full tracker + INV payload.
AGENT2_BEDROCK_MAX_TOKENS=12000
# Bedrock transport cap; only used by the *_claude strategies.
AGENT2_BEDROCK_MAX_TRANSPORT_BYTES=5242880
# OpenRouter model for the *_glm strategies (falls back to OPENROUTER_MODEL).
# AGENT2_OVERALL_TABLE_OPENROUTER_MODEL=z-ai/glm-5.3-flash

# The retrained detector now emits materially stronger confidence. Keep only
# candidates >= 0.5, trust YOLO directly at >= 0.9, and retain a spatially
# plausible 0.5+ INV box when tracker_table is already strong.
AGENT2_YOLO_OVERALL_SCHEDULE_CONFIDENCE=0.5
AGENT2_YOLO_OVERALL_SCHEDULE_FALLBACK_CONFIDENCE=0.9
AGENT2_YOLO_OVERALL_SCHEDULE_WEAK_INV_CONFIDENCE=0.5
# Expand each accepted YOLO box by this fraction of its original width/height
# on every side. The expanded crop coordinates are also drawn in the Agent2 UI.
AGENT2_YOLO_OVERALL_SCHEDULE_BBOX_EXPANSION_RATIO=0.01
AGENT2_BATCH_CLAUDE_ENABLED=true
AGENT2_BATCH_CLAUDE_MAX_PAGES=20

BEDROCK_API_KEY=
BEDROCK_MODEL=us.anthropic.claude-opus-4-7
BEDROCK_REGION=us-east-1
# Optional: set only when a deployment needs an explicit output cap.
# BEDROCK_MAX_TOKENS=12000
BEDROCK_TIMEOUT=300

# Optional OpenRouter LLM provider (OpenAI-compatible chat completions).
# Appending :nitro to a model id asks OpenRouter for its highest-throughput
# provider for that model (purely a routing hint; not a separate model id).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=count-and-design
# OPENROUTER_MAX_TOKENS=12000
OPENROUTER_TIMEOUT=300

# Agent3 Node-name extraction reads one crop per detected Node with the
# provider selected by LLM_PROVIDER below (qwen by default). After all crops
# on a page finish, one page-level review audits every recognized name
# against the schedule table; that role is Bedrock Claude unless
# AGENT3_NODE_REVIEW_LLM_PROVIDER selects another provider
# (qwen/bedrock/openrouter).
# AGENT3_NODE_REVIEW_LLM_PROVIDER=openrouter
# Set to 0/false to skip the page-level Node-name review entirely; the
# preliminary per-crop readings are then kept as-is. Defaults to true.
AGENT3_NODE_REVIEW_ENABLED=true
# Node-name extraction uses the LAN Qwen Vision endpoint when LLM_PROVIDER is
# qwen; set LLM_PROVIDER=openrouter to read crops with OPENROUTER_MODEL.
LLM_PROVIDER=qwen
LLM_BASE_URL=http://192.168.70.249:8004
LLM_MODEL=Qwen3.5-9B
LLM_API_KEY=EMPTY
LLM_TIMEOUT=120
LLM_MODEL_PROBE_TIMEOUT=5
LLM_MAX_COMPLETION_TOKENS=128
LLM_REASONING_EFFORT=none
LLM_INCLUDE_REASONING=false

# Agent3: concurrent Node-Qwen/table requests per recognition run.
AGENT3_IO_WORKERS=32

# Maximum number of high-resolution pages decoded by Agent3 at once. Each
# active page owns a large RGB bitmap until its OCR work completes.
AGENT3_PAGE_WORKERS=2
# Defensive long-side cap for the bitmap passed to Agent3 YOLO. Agent3 pages
# are rendered at up to 6000px for high-resolution OCR crops; the bundled
# models receive this smaller copy and detections are mapped back to the
# high-resolution page coordinates.
AGENT3_YOLO_MAX_SIDE=3072
# Optional grayscale for table OCR / Node crops (not the UI display image).
AGENT3_GRAYSCALE_IMAGES=false
# Line enhance for Tracker/Box YOLO only (downscale first, then enhance).
# Table locate/OCR and UI stay sharp.
AGENT3_LINE_ENHANCE=false
# Optional override for Agent3 ONNX page workers. When omitted, workers are
# derived from logical CPU count while reserving roughly four threads/session.
# AGENT3_YOLO_WORKERS=4

AGENT3_YOLO_TRACKER_CONFIDENCE=0.35
AGENT3_YOLO_BOX_CONFIDENCE=0.25
AGENT3_YOLO_BLOCK_SCHEDULE_CONFIDENCE=0.25
AGENT3_YOLO_BLOCK_SCHEDULE_FALLBACK_CONFIDENCE=0.8
# Expand YOLO table boxes used as final regions on all sides by this fraction.
AGENT3_YOLO_BLOCK_SCHEDULE_BBOX_EXPANSION_RATIO=0.01

# Legacy screenshot OCR provider (not used by Agent3).
COUNT_AND_DESIGN_OCR_BASE_URL=http://192.168.70.249:8080/v1
COUNT_AND_DESIGN_OCR_MODEL=
COUNT_AND_DESIGN_OCR_PROMPT=Free OCR.
COUNT_AND_DESIGN_OCR_API_KEY=EMPTY
COUNT_AND_DESIGN_OCR_MAX_TOKENS=4096

# Updater service configuration.
UPDATER_GITLAB_PROJECT_PATH=design-2d/count-and-design
UPDATER_GITLAB_API_BASE=http://192.168.5.6:3040/api/v4
UPDATER_GITLAB_TOKEN=
UPDATER_GITLAB_VERIFY_SSL=true
